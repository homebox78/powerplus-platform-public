# 플랫폼 로컬 개발 — 값은 각 PC 가 따로 채운다. scripts/sync-config.mjs 가 api/config.php 에 주입(예정)
DATABASE_URL=mysql://root:root@127.0.0.1:3306/powerplus
APP_SECRET=change-me-48chars
OAUTH_GOOGLE_ID=
OAUTH_GOOGLE_SECRET=
OAUTH_NAVER_ID=
OAUTH_NAVER_SECRET=
OAUTH_KAKAO_ID=
OAUTH_KAKAO_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
STAFF_DOMAIN=solideos.com
SUPERADMIN_EMAIL=
# 옛 DB 이관 원천(읽기 전용)
LEGACY_POWERPLUS_URL=mysql://root:root@127.0.0.1:3306/powerplus_legacy
LEGACY_HOMEBOX_URL=mysql://root:root@127.0.0.1:3306/homebox
# 운영 실데이터 이관 원천(읽기 전용 덤프를 로컬에 복원한 DB) — db/migrate-legacy/run-all.mjs
LEGACY_PP_FULL_URL=mysql://root:root@127.0.0.1:3306/legacy_pp_full
LEGACY_HB_FULL_URL=mysql://root:root@127.0.0.1:3306/legacy_hb_full
LEGACY_DECK_URL=mysql://root:root@127.0.0.1:3306/legacy_deck
# 홈박스 갤러리 썸네일 원천 폴더(운영 /var/www/html/homebox/storage/gallery 를 받아 둔 곳). 비우면 썸네일 복사 안 함
LEGACY_HB_GALLERY_DIR=
