<Project Sdk="Microsoft.NET.Sdk">
  <!-- powerAssets 설치 마법사 — 빌드는 node scripts/build-installer.mjs (아이콘 생성 → publish → apps/addin/release) -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>powerAssets_Setup</AssemblyName>
    <RootNamespace>PowerPlusInstaller</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Product>powerAssets 설치 마법사</Product>
    <AssemblyTitle>powerAssets 설치 마법사</AssemblyTitle>
    <Company>㈜솔리데오</Company>
    <Copyright>© 2026 ㈜솔리데오</Copyright>
    <Version>1.1.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="installer.html" />
    <EmbeddedResource Include="manifest.xml" />
    <EmbeddedResource Include="..\assets\fonts\momo-v2.woff2" LogicalName="momo-v2.woff2" />
  </ItemGroup>
</Project>
